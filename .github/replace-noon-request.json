  "story": {
    "profile": "horror",
    "series": "ملفات غامضه",
    "title": "السفينة كابتن: كارثة حقيقية في ليلة عاصفة",
    "canonical_subject": "hms-captain-capsize-1870",
    "topic_key": "remotion-hms-captain-capsize-1870",
    "source": {
      "url": "https://www.rmg.co.uk/stories/maritime-history/hms-captain-britains-forgotten-maritime-disaster",
      "publisher": "Royal Museums Greenwich",
      "title": "HMS Captain: Britain's forgotten maritime disaster"
    },
    "scenes": [
      {
        "label": "سفينة قوتها ما أنقذتهاش",
        "narration": "سفينة حربية حديثة، مدافع في أبراج دوارة، وأشرعة فوق هيكل حديدي. منظرها يوحي بالقوة. لكن في ليلة عاصفة سنة ألف تمنمية وسبعين، السفينة كابتن انقلبت، ومعاها تقريبًا كل طاقمها. دي كارثة حقيقية، مش حكاية سفينة أشباح.",
        "visual": {
          "kind": "photo",
          "asset": "media/horror-ship.jpg",
          "asset_label": "صورة تاريخية للسفينة كابتن • Public domain"
        },
        "id": "scene_1",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "قدام الساحل الإسباني",
        "narration": "الكارثة حصلت قبالة رأس فينيستير في إسبانيا، خلال عاصفة في ليلة السادس للسابع من سبتمبر. المكان الموضح على الخريطة منطقة الحادث بشكل تقريبي؛ مش تحديدًا مؤكدًا لمكان الحطام، لأن التفصيلة دي لسه محتاجة إثبات.",
        "visual": {
          "kind": "map",
          "longitude": -9.27,
          "latitude": 42.88,
          "zoom": 4.6,
          "detail": "قبالة رأس فينيستير • نطاق تقريبي للحادث"
        },
        "id": "scene_2",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "الخطر كان في التصميم",
        "narration": "كابتن جمعت تسليحًا متطورًا مع أشرعة كبيرة وسطح منخفض قريب من المياه. المخاوف من التصميم كانت موجودة قبل الكارثة. والسؤال ماكانش قوة المدافع بس، لكن هل السفينة تقدر تستعيد اتزانها، لما الريح والموج يميلوها بقوة؟",
        "visual": {
          "kind": "photo",
          "asset": "media/horror-plan.jpg",
          "asset_label": "رسم تاريخي لتصميم السفينة • Public domain"
        },
        "id": "scene_3",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "ميلان ما رجعتش منه",
        "narration": "الرسم هنا بيوضح مبدأ الثبات، مش بيعيد حادث الغرق بقياسات مؤكدة. السفينة لازم تقدر تقاوم الميلان وترجع لوضعها. الجمع بين هيئة البدن وارتفاع الأشرعة وأثر الريح كان جزءًا أساسيًا من الأسئلة اللي ارتبطت بكارثة كابتن.",
        "visual": {
          "kind": "stability"
        },
        "id": "scene_4",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "ليلة اتحولت لكارثة",
        "narration": "وسط العاصفة، انقلبت السفينة وضاعت مئات الأرواح، ومن بينهم مصممها كوبر فيبس كولز. الرسمة التاريخية قدامك تصور المأساة، لكنها مش صورة فوتوغرافية للحظة الغرق. ولا فيه هنا حوار متخيل بننسبه لحد كان على متنها.",
        "visual": {
          "kind": "photo",
          "asset": "media/horror-storm.jpg",
          "asset_label": "رسم تاريخي للكارثة • ليس تصويرًا للحظة الغرق"
        },
        "id": "scene_5",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "شهادات وأسئلة بعد الغرق",
        "narration": "بعد الكارثة، فضل قدام الباحثين سجلات سفن، وشهادات ناجين، ووثائق التحقيق. وظهرت أسئلة عن التصميم والتنفيذ والظروف الجوية. محاولة فهم اللي حصل مهمة، لأن تفسير مأساة بالحظ السيئ وحده، ممكن يخبي تحذيرات كان لازم تتسمع من البداية.",
        "visual": {
          "kind": "photo",
          "asset": "media/horror-survivors.jpg",
          "asset_label": "رسم تاريخي للناجين • Public domain"
        },
        "id": "scene_6",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "الحطام المرشح مش دليل نهائي",
        "narration": "في مسح بحري سنة ألفين واتنين وعشرين، اتشاف حطام شكله العام ممكن يناسب كابتن. لكن المصدر البحثي بيوضح إن تأكيد هويته لسه هدف للتحقيق، مش خبر محسوم. وجود شكل قريب تحت المياه، لوحده، مايثبتش إن اللغز اتحل.",
        "visual": {
          "kind": "timeline",
          "timeline": [
            {
              "year": "1870",
              "text": "انقلاب كابتن في عاصفة"
            },
            {
              "year": "2022",
              "text": "رصد حطام محتمل • الهوية غير مؤكدة"
            }
          ]
        },
        "id": "scene_7",
        "labels": [],
        "visual_mode": "hero"
      },
      {
        "label": "الرعب الحقيقي: تحذير اتساب",
        "narration": "اللي يخوّف في القصة دي مش كائن ظهر في البحر، لكن سفينة قُدّمت كرمز للتقدم، وانتهت بمأساة خلال شهور. وبين الصور والرسومات والسجلات، بيبقى السؤال الأصعب: إمتى الثقة في مشروع كبير، بتخلينا نستهين بخطر حقيقي؟",
        "visual": {
          "kind": "photo",
          "asset": "media/horror-deck.jpg",
          "asset_label": "صورة تاريخية على سطح السفينة • Public domain"
        },
        "id": "scene_8",
        "labels": [],
        "visual_mode": "hero"
      }
    ],
