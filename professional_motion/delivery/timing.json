  "caption_groups": [
    {
      "text": "الصحراء الليبية النهارده مش إلا يابسة",
      "start": 0,
      "end": 3.48
    },
    {
      "text": "وقاحلة، لكنها كانت زمان جنة خضراء",
      "start": 3.48,
      "end": 7.22
    },
    {
      "text": "مليانة بحيرات ومساحات سافانا ضمن الفترة",
      "start": 8.0,
      "end": 11.88
    },
    {
      "text": "المطيرة الأفريقية بين أربعة عشر ألف",
      "start": 11.88,
      "end": 13.98
    },
    {
      "text": "وخمسمائة وخمسة آلاف سنة مضت. جوه",
      "start": 16.42,
      "end": 17.84
    },
    {
      "text": "أعمق تجويف في ملجأ تكركوري الصخري",
      "start": 19.08,
      "end": 20.64
    },
    {
      "text": "بجبال تادرارت أكاكوس، اتبحتث دفنات بشرية",
      "start": 21.72,
      "end": 25.76
    },
    {
      "text": "هامة تعود لأزمنة الرعي القديمة، وخرجت",
      "start": 25.76,
      "end": 29.62
    },
    {
      "text": "منها عينتين لبنات البشر اللواتي عشن",
      "start": 29.62,
      "end": 32.6
    },
    {
      "text": "قبل حوالي سبعة آلاف سنة لتكشف",
      "start": 33.7,
      "end": 36.94
    },
    {
      "text": "أسراراً مدفونة تحت الرمال. حفظ الحمض",
      "start": 38.08,
      "end": 40.28
    },
    {
      "text": "النووي في المنطقة دي كان شبه",
      "start": 40.58,
      "end": 42.66
    },
    {
      "text": "مستحيل بسبب الظروف المناخية القاسية، لكن",
      "start": 42.66,
      "end": 46.34
    },
    {
      "text": "العلماء استخدموا تقنيات التقاط دقيقة عشان",
      "start": 46.34,
      "end": 49.72
    },
    {
      "text": "يرجعوا معلومات وراثية مهمة جدا من",
      "start": 49.72,
      "end": 52.96
    },
    {
      "text": "جذور الأسنان وقطع الشظايا العظمية المتآكلة.",
      "start": 52.96,
      "end": 56.96
    },
    {
      "text": "النتائج الجينية أظهرت مفاجأة صادمة لكل",
      "start": 57.46,
      "end": 60.5
    },
    {
      "text": "الباحثين؛ أفراد تكركوري بيحملوا سلالة شمال",
      "start": 61.58,
      "end": 64.28
    },
    {
      "text": "أفريقية فريدة ومجهولة تماما قبل كده،",
      "start": 64.28,
      "end": 67.36
    },
    {
      "text": "فضلت معزولة ومنفصلة عن بقية السلالات",
      "start": 68.16,
      "end": 70.76
    },
    {
      "text": "الأفريقية وغير الأفريقية طوال تاريخها الطويل.",
      "start": 70.76,
      "end": 73.46
    },
    {
      "text": "بمقارنة العينات دي، لقى الباحثين إن",
      "start": 74.72,
      "end": 77.42
    },
    {
      "text": "نسبة حمض النياندرتال عندهم قليلة جدا",
      "start": 77.42,
      "end": 80.46
    },
    {
      "text": "مقارنة بالبشر خارج إفريقيا، ده غير",
      "start": 80.46,
      "end": 83.26
    },
    {
      "text": "القرابة الواضحة مع صيادي مغارة تافورالت",
      "start": 83.26,
      "end": 86.18
    },
    {
      "text": "بالمغرب اللي عاشوا قبل خمسة عشر",
      "start": 86.18,
      "end": 87.82
    },
    {
      "text": "ألف سنة كاملة. السؤال الأهم كان",
      "start": 88.48,
      "end": 91.74
    },
    {
      "text": "عن طريقة وصول الرعي للمنطقة؛ هل",
      "start": 91.74,
      "end": 94.98
    },
    {
      "text": "جه مع هجرة شعوب جديدة، ولا",
      "start": 95.78,
      "end": 97.08
    },
    {
      "text": "عبر الانتشار الثقافي؟ البيانات الجينية أكدت",
      "start": 97.08,
      "end": 101.62
    },
    {
      "text": "بكل وضوح إن الرعي انتقل ثقافيا",
      "start": 101.62,
      "end": 105.22
    },
    {
      "text": "وسط هذه السلالة المحلية المعزولة. رغم",
      "start": 106.22,
      "end": 109.16
    },
    {
      "text": "نجاح التحاليل الضخمة والبيانات اللي ظهرت،",
      "start": 109.44,
      "end": 113.0
    },
    {
      "text": "لسه فيه تفاصيل غامضة حوالين الأصول",
      "start": 113.0,
      "end": 115.88
    },
    {
      "text": "العميقة للسلالة دي وعلاقتها المعقدة بالمجموعات",
      "start": 116.32,
      "end": 120.06
    },
    {
      "text": "البشرية اللي ظهرت في العصور القديمة",
      "start": 120.66,
      "end": 122.74
    },
    {
      "text": "عبر القارة الإفريقية. في النهاية، فتحت",
      "start": 122.74,
      "end": 127.18
    },
    {
      "text": "عينات تكركوري باب جديد لفهم التاريخ",
      "start": 127.18,
      "end": 130.8
    },
    {
      "text": "الديموغرافي للصحراء، وأثبتت بشكل قاطع إن",
      "start": 131.42,
      "end": 134.7
    },
    {
      "text": "شمال إفريقيا كان خزانا وراثيا مستقلا",
      "start": 134.7,
      "end": 139.02
    },
    {
      "text": "صنع تاريخه البشري في قلب الطبيعة",
      "start": 139.02,
      "end": 142.1
    },
    {
      "text": "القاسية.",
      "start": 142.1,
      "end": 142.68
    }
  ],
