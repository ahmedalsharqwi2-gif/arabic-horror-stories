  "caption_groups": [
    {
      "text": "طلعت سلم العمارة بعد نص الليل،",
      "start": 0,
      "end": 3.0
    },
    {
      "text": "وأنا سامع صوت رجلي بيرد من",
      "start": 3.54,
      "end": 5.9
    },
    {
      "text": "فوق. وقفت. الصوت كمل درجتين لوحده،",
      "start": 5.9,
      "end": 10.200000000000001
    },
    {
      "text": "وبعدين سكت. قدامي كان باب الدور",
      "start": 10.72,
      "end": 14.06
    },
    {
      "text": "الرابع، بنفس الخدش الطويل اللي جنب",
      "start": 14.06,
      "end": 16.98
    },
    {
      "text": "المقبض. الخدش ده أنا عارفه كويس.",
      "start": 16.98,
      "end": 21.06
    },
    {
      "text": "على بسطة السلم كانت فيه مراية",
      "start": 21.06,
      "end": 23.08
    },
    {
      "text": "قديمة. قربت أصلح ياقة القميص، ورفعت",
      "start": 23.24,
      "end": 27.44
    },
    {
      "text": "إيدي الشمال. اللي في المراية ما",
      "start": 27.44,
      "end": 31.12
    },
    {
      "text": "اتحركش. فضلت إيده تحت، رغم إن",
      "start": 31.58,
      "end": 34.56
    },
    {
      "text": "إيدي قدام وشي. وبعد ثانية، رفعها",
      "start": 34.56,
      "end": 38.92
    },
    {
      "text": "ببطء، وأنا كنت نزلتها خلاص. ما",
      "start": 38.92,
      "end": 42.54
    },
    {
      "text": "استنتش أفهم. طلعت بسرعة، وعديت بسطة",
      "start": 42.54,
      "end": 46.24
    },
    {
      "text": "وبسطة. بس الباب اللي قابلني كان",
      "start": 46.24,
      "end": 49.82
    },
    {
      "text": "باب الدور الرابع، بنفس الخدش جنب",
      "start": 49.82,
      "end": 52.52
    },
    {
      "text": "المقبض. نزلت بدل ما أطلع. لقيته",
      "start": 52.52,
      "end": 56.9
    },
    {
      "text": "تاني. المرة دي، سمعت حركة المقبض",
      "start": 56.9,
      "end": 60.56
    },
    {
      "text": "من جوه، قبل ما أقرب. باب",
      "start": 60.56,
      "end": 63.7
    },
    {
      "text": "شقتي ظهر في آخر الممر، موارب",
      "start": 64.02,
      "end": 66.18
    },
    {
      "text": "زي ما بسيبه ساعات. كنت عايز",
      "start": 66.18,
      "end": 68.86
    },
    {
      "text": "أي حاجة مألوفة، فدخلت وقفلت ورايا.",
      "start": 68.86,
      "end": 72.38
    },
    {
      "text": "أول ما القفل عمل تكته، صوت",
      "start": 73.25999999999999,
      "end": 76.34
    },
    {
      "text": "السلم اختفى. حتى صوت الشارع اختفى.",
      "start": 76.34,
      "end": 79.24
    },
    {
      "text": "المكان بقى ساكت بطريقة توجع الودان.",
      "start": 80.2,
      "end": 83.28
    },
    {
      "text": "مديت إيدي أدور على مفتاح النور.",
      "start": 83.28,
      "end": 85.16
    },
    {
      "text": "مفيش مفتاح. ومفيش كنبة، ولا ترابيزة،",
      "start": 85.64,
      "end": 88.62
    },
    {
      "text": "ولا أي حاجة من شقتي. قدامي",
      "start": 89.78,
      "end": 92.34
    },
    {
      "text": "نفس الممر الطويل. وفي آخره، نفس",
      "start": 92.34,
      "end": 96.5
    },
    {
      "text": "باب الدور الرابع. بس الخدش المرة",
      "start": 96.5,
      "end": 99.06
    },
    {
      "text": "دي كان من الناحية اللي أنا",
      "start": 99.06,
      "end": 100.88
    },
    {
      "text": "واقف فيها. فوق الباب ساعة قديمة،",
      "start": 100.88,
      "end": 104.38
    },
    {
      "text": "عقاربها واقفة. مع كده، كنت سامع",
      "start": 106.28,
      "end": 107.28
    },
    {
      "text": "تكة منتظمة من ورا الباب. قربت",
      "start": 107.5,
      "end": 110.64
    },
    {
      "text": "ودني، فالتكة وقفت. بعدين سمعت نفسي",
      "start": 110.64,
      "end": 114.08
    },
    {
      "text": "باخد نفس طويل من جوه. حبست",
      "start": 114.08,
      "end": 116.92
    },
    {
      "text": "نفسي. النفس اللي ورا الباب كمل",
      "start": 116.92,
      "end": 119.82
    },
    {
      "text": "عادي. رجعت لورا واحدة واحدة. في",
      "start": 119.82,
      "end": 123.1
    },
    {
      "text": "آخر الممر كان فيه خيال واقف،",
      "start": 123.38,
      "end": 125.64
    },
    {
      "text": "ملامحه مش باينة. ما كانش بيجري",
      "start": 125.64,
      "end": 128.6
    },
    {
      "text": "ورايا، ولا بيقرب. كان مستني. كل",
      "start": 128.6,
      "end": 132.84
    },
    {
      "text": "ما أبعد عنه، ألاقي المراية أقرب",
      "start": 132.84,
      "end": 135.12
    },
    {
      "text": "لوشي. وكأن الممر كله بيزقني ناحيتها.",
      "start": 135.12,
      "end": 138.44
    },
    {
      "text": "بصيت في المراية عشان أعرف هو",
      "start": 138.44,
      "end": 140.68
    },
    {
      "text": "ورايا ولا لأ. اللي جواها رفع",
      "start": 140.68,
      "end": 143.26
    },
    {
      "text": "إيده الشمال. أنا ما كنتش رفعتها.",
      "start": 143.28,
      "end": 145.68
    },
    {
      "text": "حاولت أثبت دراعي، بس إيدي طلعت",
      "start": 146.36,
      "end": 148.82
    },
    {
      "text": "لوحدها وراه. ساعتها فهمت: أنا مش",
      "start": 148.82,
      "end": 152.78
    },
    {
      "text": "اللي واقف قدام المراية. أنا اللي",
      "start": 152.78,
      "end": 155.7
    },
    {
      "text": "بقيت الانعكاس.",
      "start": 155.7,
      "end": 156.52
    }
  ],
