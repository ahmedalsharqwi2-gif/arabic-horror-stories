  "caption_groups": [
    {
      "text": "في شهر مايو سنة 1845، اتحركت",
      "start": 0,
      "end": 4.36
    },
    {
      "text": "سفينتا HMS Erebus وHMS Terror من",
      "start": 5.46,
      "end": 8.54
    },
    {
      "text": "بريطانيا. الهدف كان البحث عن الممر",
      "start": 8.54,
      "end": 11.7
    },
    {
      "text": "الشمالي الغربي، وهو ممر بحري مهم",
      "start": 11.7,
      "end": 14.78
    },
    {
      "text": "بيربط بين المحيط الأطلسي والمحيط الهادي.",
      "start": 14.78,
      "end": 18.16
    },
    {
      "text": "بقيادة المستكشف جون فرانكلين، السفينتين وصلوا",
      "start": 19.060000000000002,
      "end": 23.22
    },
    {
      "text": "إلى شمال كندا. في أواخر شهر",
      "start": 23.22,
      "end": 26.26
    },
    {
      "text": "يوليو، شاهدهم قارب صيد حيتان في",
      "start": 26.26,
      "end": 28.78
    },
    {
      "text": "خليج بافن وهم مستنيين الجليد يذوب",
      "start": 28.78,
      "end": 31.2
    },
    {
      "text": "عشان يبدأوا طريقهم نحو مضيق بيرينغ،",
      "start": 31.8,
      "end": 34.46
    },
    {
      "text": "ودي كانت آخر مرة حد يشوف",
      "start": 35.42,
      "end": 39.5
    },
    {
      "text": "الطاقم عايش. الرجال على السفينتين واجهوا",
      "start": 39.5,
      "end": 42.78
    },
    {
      "text": "ظروف قاسية جداً وبرد قارس بيخلي",
      "start": 43.98,
      "end": 47.68
    },
    {
      "text": "درجات الحرارة تنزل لتحت الصفر بكتير.",
      "start": 47.68,
      "end": 51.42
    },
    {
      "text": "البرد كان بيأثر على الجلد لدرجة",
      "start": 51.42,
      "end": 54.24
    },
    {
      "text": "إن نزع غطاء الوجه ممكن يسلخ",
      "start": 54.24,
      "end": 56.9
    },
    {
      "text": "الجلد واللحية، والناس كانت بتضطر تعيش",
      "start": 56.9,
      "end": 60.7
    },
    {
      "text": "في برد شديد تحت السطح. السفينتين",
      "start": 60.92,
      "end": 63.24
    },
    {
      "text": "اتحصروا في الجليد قرب جزيرة كينج",
      "start": 65.16,
      "end": 67.26
    },
    {
      "text": "وليام. ضغط الكتل الجليدية الضخمة وحركة",
      "start": 68.42,
      "end": 71.12
    },
    {
      "text": "الجبال العائمة كان بيحط الطاقم في",
      "start": 71.12,
      "end": 73.44
    },
    {
      "text": "خطر مباشر ومستمر، والمؤونة الكافية لثلاث",
      "start": 73.44,
      "end": 77.36
    },
    {
      "text": "سنين بدأت تخلص مع مرور الوقت",
      "start": 77.48,
      "end": 80.36
    },
    {
      "text": "الطويل وسط العزلة. في سنة 1859،",
      "start": 80.36,
      "end": 85.34
    },
    {
      "text": "ظهرت الورقة الوحيدة اللي كشفت جزء",
      "start": 85.34,
      "end": 88.56
    },
    {
      "text": "من الحقيقة. مذكرة نقطة فيكتوري وضحت",
      "start": 88.56,
      "end": 93.14
    },
    {
      "text": "إن السفينتين اتهجروا في أبريل سنة",
      "start": 93.14,
      "end": 95.32
    },
    {
      "text": "1848 بعد ما فضلوا محشورين في",
      "start": 95.32,
      "end": 99.24
    },
    {
      "text": "الجليد سنين طويلة. المية وخمسة ناجين",
      "start": 99.24,
      "end": 103.34
    },
    {
      "text": "من الطاقم بقيادة الكابتن كروزير قرروا",
      "start": 103.34,
      "end": 106.76
    },
    {
      "text": "يمشوا على رجليهم جنوباً باتجاه نهر",
      "start": 106.76,
      "end": 108.7
    },
    {
      "text": "باك. لكن الضعف بسبب نقص الفيتامينات",
      "start": 108.86,
      "end": 112.26
    },
    {
      "text": "والمرض خلى أغلبهم يموت في الطريق",
      "start": 112.26,
      "end": 115.48
    },
    {
      "text": "على الساحل الغربي للجزيرة في ظروف",
      "start": 115.48,
      "end": 118.44
    },
    {
      "text": "مرعبة. في الثمانينيات، رجع باحثون لفحص",
      "start": 118.44,
      "end": 123.0
    },
    {
      "text": "رفات البشر اللي لقوها على الجزيرة.",
      "start": 123.32,
      "end": 125.2
    },
    {
      "text": "التحاليل بينت إن عظام الرجال كان",
      "start": 126.54,
      "end": 127.76
    },
    {
      "text": "فيها نسب عالية جداً من عنصر",
      "start": 127.76,
      "end": 129.78
    },
    {
      "text": "الرصاص، وده رجح إن أكل العلب",
      "start": 129.78,
      "end": 132.76
    },
    {
      "text": "المحفوظة اللي اتسدت بمادة الرصاص ساهم",
      "start": 132.76,
      "end": 135.76
    },
    {
      "text": "في كارثة الطاقم. في سنتي 2014",
      "start": 135.76,
      "end": 139.36
    },
    {
      "text": "و2016، تم اكتشاف حطام إريبوس وتيرور",
      "start": 139.36,
      "end": 143.22
    },
    {
      "text": "في قاع البحر. الاكتشافات دي قدمت",
      "start": 143.94,
      "end": 146.68
    },
    {
      "text": "أدلة مادية جديدة من خلال آلاف",
      "start": 146.68,
      "end": 148.7
    },
    {
      "text": "القطع اللي استخرجوها لتروي قصة واحدة",
      "start": 148.7,
      "end": 151.52
    },
    {
      "text": "من أسوأ الكوارث في تاريخ الاستكشاف",
      "start": 151.52,
      "end": 154.24
    },
    {
      "text": "القطبي.",
      "start": 154.24,
      "end": 154.68
    }
  ],
