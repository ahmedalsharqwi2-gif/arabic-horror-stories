{
  "duration": 157.16,
  "scenes": [
    {
      "id": "scene_1",
      "label": "الدور الرابع",
      "narration": "طلعت سلم العمارة بعد نص الليل، وأنا سامع صوت رجلي بيرد من فوق. وقفت. الصوت كمل درجتين لوحده، وبعدين سكت. قدامي كان باب الدور الرابع، بنفس الخدش الطويل اللي جنب المقبض. الخدش ده أنا عارفه كويس.",
      "labels": [],
      "visual_mode": "stairs",
      "scare_phrase": "الصوت كمل درجتين لوحده",
      "clock_motion": "none",
      "start": 0,
      "end": 21.06,
      "scare_beat": 8.18,
      "scare_end": 10.200000000000001
    },
    {
      "id": "scene_2",
      "label": "الانعكاس استنى",
      "narration": "على بسطة السلم كانت فيه مراية قديمة. قربت أصلح ياقة القميص، ورفعت إيدي الشمال. اللي في المراية ما اتحركش. فضلت إيده تحت، رغم إن إيدي قدام وشي. وبعد ثانية، رفعها ببطء، وأنا كنت نزلتها خلاص.",
      "labels": [],
      "visual_mode": "mirror",
      "scare_phrase": "اللي في المراية ما اتحركش",
      "clock_motion": "none",
      "start": 21.06,
      "end": 41.44,
      "scare_beat": 28.06,
      "scare_end": 31.12
    },
    {
      "id": "scene_3",
      "label": "السلم بيرجعني",
      "narration": "ما استنتش أفهم. طلعت بسرعة، وعديت بسطة وبسطة. بس الباب اللي قابلني كان باب الدور الرابع، بنفس الخدش جنب المقبض. نزلت بدل ما أطلع. لقيته تاني. المرة دي، سمعت حركة المقبض من جوه، قبل ما أقرب.",
      "labels": [],
      "visual_mode": "stairs",
      "scare_phrase": "سمعت حركة المقبض من جوه",
      "clock_motion": "none",
      "start": 41.44,
      "end": 63.22,
      "scare_beat": 59.26,
      "scare_end": 61.08
    },
    {
      "id": "scene_4",
      "label": "باب موارب",
      "narration": "باب شقتي ظهر في آخر الممر، موارب زي ما بسيبه ساعات. كنت عايز أي حاجة مألوفة، فدخلت وقفلت ورايا. أول ما القفل عمل تكته، صوت السلم اختفى. حتى صوت الشارع اختفى. المكان بقى ساكت بطريقة توجع الودان.",
      "labels": [],
      "visual_mode": "door",
      "scare_phrase": "حتى صوت الشارع اختفى",
      "clock_motion": "none",
      "start": 63.22,
      "end": 83.28,
      "scare_beat": 77.84,
      "scare_end": 79.24
    },
    {
      "id": "scene_5",
      "label": "مش شقتي",
      "narration": "مديت إيدي أدور على مفتاح النور. مفيش مفتاح. ومفيش كنبة، ولا ترابيزة، ولا أي حاجة من شقتي. قدامي نفس الممر الطويل. وفي آخره، نفس باب الدور الرابع. بس الخدش المرة دي كان من الناحية اللي أنا واقف فيها.",
      "labels": [],
      "visual_mode": "hall",
      "scare_phrase": "الخدش المرة دي كان من الناحية",
      "clock_motion": "none",
      "start": 83.28,
      "end": 102.16,
      "scare_beat": 98.46,
      "scare_end": 100.32
    },
    {
      "id": "scene_6",
      "label": "الساعة ساكتة",
      "narration": "فوق الباب ساعة قديمة، عقاربها واقفة. مع كده، كنت سامع تكة منتظمة من ورا الباب. قربت ودني، فالتكة وقفت. بعدين سمعت نفسي باخد نفس طويل من جوه. حبست نفسي. النفس اللي ورا الباب كمل عادي.",
      "labels": [],
      "visual_mode": "clock",
      "scare_phrase": "النفس اللي ورا الباب كمل",
      "clock_motion": "stopped",
      "start": 102.16,
      "end": 120.96,
      "scare_beat": 118.12,
      "scare_end": 119.82
    },
    {
      "id": "scene_7",
      "label": "حد مستنيني",
      "narration": "رجعت لورا واحدة واحدة. في آخر الممر كان فيه خيال واقف، ملامحه مش باينة. ما كانش بيجري ورايا، ولا بيقرب. كان مستني. كل ما أبعد عنه، ألاقي المراية أقرب لوشي. وكأن الممر كله بيزقني ناحيتها.",
      "labels": [],
      "visual_mode": "hall",
      "scare_phrase": "كان مستني",
      "clock_motion": "none",
      "start": 120.96,
      "end": 138.44,
      "scare_beat": 130.02,
      "scare_end": 131.46
    },
    {
      "id": "scene_8",
      "label": "مين بيقلد مين؟",
      "narration": "بصيت في المراية عشان أعرف هو ورايا ولا لأ. اللي جواها رفع إيده الشمال. أنا ما كنتش رفعتها. حاولت أثبت دراعي، بس إيدي طلعت لوحدها وراه. ساعتها فهمت: أنا مش اللي واقف قدام المراية. أنا اللي بقيت الانعكاس.",
      "labels": [],
      "visual_mode": "mirror",
      "scare_phrase": "أنا اللي بقيت الانعكاس",
      "clock_motion": "none",
      "start": 138.44,
      "end": 157.16,
      "scare_beat": 154.62,
      "scare_end": 156.52
    }
  ],
